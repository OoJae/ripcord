{
  "name": "ripcord",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous MEV-aware liquidation-protection agent for Aave V3 on Base, executing through KeeperHub",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "tsx src/index.ts",
    "status": "tsx src/status.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
